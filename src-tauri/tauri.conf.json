{
  "productName": "Trackwise",
  "version": "1.0.11",
  "identifier": "com.trackwise.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Trackwise",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMDRFNzlGOEU4ODFCOTkKUldTWkc0aU9uK2NFc0RLL1FrdW9IM3lUbnAvY0JJbkJSK3U2cUlHeVIxejM4d21HRkhnMG9tcWYK",
      "endpoints": [
        "https://github.com/BrettFX/Trackwise/releases/latest/download/latest.json"
      ]
    }
  }
}
