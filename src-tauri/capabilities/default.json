{
  "$schema": "../node_modules/@tauri-apps/cli/schema/capabilities.json",
  "identifier": "default",
  "description": "Default capabilities for Trackwise",
  "windows": ["main"],
  "permissions": [
    "updater:default",
    "process:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://localhost:11434/*" }, { "url": "http://127.0.0.1:11434/*" }]
    }
  ]
}
